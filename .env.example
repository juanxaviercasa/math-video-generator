# IA
AI_PROVIDER=openrouter
LLM_PROVIDER=openrouter

# OpenRouter (free / low-cost default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Gemini (free / paid)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (paid fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App runtime
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
APP_URL=http://localhost:5173
MEDIA_ROOT=/tmp/math-video-generator
REDIS_URL=redis://127.0.0.1:6379
VIDEO_QUEUE_NAME=math-video-generation
VIDEO_WORKER_CONCURRENCY=1
VIDEO_JOB_ATTEMPTS=2
VIDEO_JOB_BACKOFF_MS=5000
VIDEO_JOB_STALE_MS=900000
FAILED_ARTIFACT_RETENTION_MS=86400000
ARTIFACT_CLEANUP_INTERVAL_MS=3600000
# Legacy: ya no se usa para autenticar usuarios; se conserva solo para compatibilidad.
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Supabase: usa el pooler para la aplicación y la conexión directa para Prisma CLI.
DATABASE_URL=postgresql://prisma.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://prisma:password@db.project-ref.supabase.co:5432/postgres
ALLOW_SIMULATION=false

# Narración gratuita: voz neural online con fallback local espeak
TTS_PROVIDER=edge
TTS_NEURAL_VOICE=es-MX-DaliaNeural
TTS_NEURAL_RATE=-8%
TTS_NEURAL_RETRIES=2
# Keep the approved neural voice; set true only for explicit local fallback.
TTS_ALLOW_LOCAL_FALLBACK=false
# Keep false in production: unsupported math families must have a deterministic solver first.
ALLOW_UNVERIFIED_MATH_VIDEO=false
# Experimental: synchronize visual micro-events to neural narration only after validation.
NARRATION_TIMELINE=false
REMOTION_ENABLED=false
REMOTION_PROJECT_DIR=./tools/remotion-pilot
REMOTION_COMPOSITION=LessonTimelineEditorial
REMOTION_FPS=30
TTS_VOICE=es-la
TTS_SPEED=145

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Math Video Generator
VITE_APP_VERSION=0.1.0
