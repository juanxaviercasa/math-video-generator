# Copy to .env.personal on the Oracle host; NEVER commit the populated copy.
# Single-user deployment: your only Supabase Auth user is already confirmed.
# Copy that user's UUID from Authentication > Users into OWNER_USER_ID on Oracle.
# Do not create a second user or publish the owner's UUID in another application.
PERSONAL_MODE=true
OWNER_USER_ID=
APP_URL=https://math.forjavia.site
VITE_API_URL=https://api-math.forjavia.site/api

# Supabase hosts the application's PostgreSQL tables as well as Auth.
# Retrieve the database credentials securely in Supabase Dashboard > Connect.
# Use the Session pooler (:5432) when Oracle has IPv4 only.
# URL-encode the password if it contains reserved URL characters.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=

# Supabase project's publishable (nonsecret) key is prefilled for convenience.
# NEVER put the service_role key or database password in this repository.
SUPABASE_URL=https://jplhbgyhswvbghhzhjvm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_nlwINeJLy_a-XWUcigMdcQ_xTiV9Jos

# Optional AI providers: set on server only.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=

# Optional: an existing private HTTPS ViralForge gateway, or a reachable service
# name on a shared Docker network. Do not use http://127.0.0.1 from inside Docker.
# Empty = disabled; no Kaggle sessions will start automatically.
VIRALFORGE_INTERNAL_URL=

# Reliable educational narration. Disable silent substitutions.
TTS_PROVIDER=edge
TTS_NEURAL_VOICE=es-PE-CamilaNeural
TTS_ALLOW_LOCAL_FALLBACK=false

# Conservative resource limits; adjust after measuring your VPS.
API_CPUS=0.5
API_MEMORY=768m
WORKER_CPUS=1.0
WORKER_MEMORY=3g
REMOTION_ENABLED=false
