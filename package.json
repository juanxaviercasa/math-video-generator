{
  "name": "math-video-generator",
  "version": "0.1.0",
  "description": "Transform math problems into educational videos automatically",
  "author": "Dang Minh Duc <dangduc131@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "start": "npm run start --workspaces --if-present",
    "start:backend": "npm --workspace backend run start",
    "start:frontend": "npm --workspace frontend run preview",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && npm exec -- rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
