# Copy to .env.personal on the Oracle host; NEVER commit the populated copy.
# Single-user deployment. Pin to your existing Supabase Auth UUID (not your email).
PERSONAL_MODE=true
OWNER_USER_ID=
APP_URL=https://math.forjavia.site
VITE_API_URL=https://api-math.forjavia.site/api

# Private PostgreSQL container credentials. URL-encode reserved characters in DB_PASSWORD.
DB_USER=mathvideo
DB_PASSWORD=
JWT_SECRET=

# Existing Supabase project (no new user registrations).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional AI providers: set on server only.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=

# Optional: an existing private HTTPS ViralForge gateway, or a reachable service
# name on a shared Docker network. Do not use http://127.0.0.1 from inside Docker.
# Empty = disabled; no Kaggle sessions will start automatically.
VIRALFORGE_INTERNAL_URL=

# Reliable educational narration. Disable silent substitutions.
TTS_PROVIDER=edge
TTS_NEURAL_VOICE=es-PE-CamilaNeural
TTS_ALLOW_LOCAL_FALLBACK=false

# Conservative resource limits; adjust after measuring your VPS.
API_CPUS=0.5
API_MEMORY=768m
WORKER_CPUS=1.0
WORKER_MEMORY=3g
REMOTION_ENABLED=false
