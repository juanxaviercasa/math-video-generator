# IA
AI_PROVIDER=openrouter
LLM_PROVIDER=openrouter

# OpenRouter (free / low-cost default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Gemini (free / paid)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (paid fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App runtime
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
APP_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:password@localhost:5432/math_video_generator
ALLOW_SIMULATION=false

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Math Video Generator
VITE_APP_VERSION=0.1.0
